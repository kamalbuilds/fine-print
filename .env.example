OTARI_API_KEY=
# EU accounts: https://eu.api.otari.ai/api
OTARI_BASE_URL=https://api.otari.ai/api
# Reader: a routing policy name (ours: fineprint-reader, gpt-oss-120b with Qwen3 235B as fallback) or a model id
OTARI_MODEL=openai/gpt-oss-120b
# Second reader: a different open-weight model, re-rates each quote blind
OTARI_CHECKER_MODEL=alibaba/qwen3-235b-a22b-instruct-2507
# Optional: service key, so every visitor is an Otari end user with their own budget
OTARI_SERVICE_KEY=
# Optional: guardrail profile mandated in the dashboard, run on every fetched page
OTARI_GUARDRAIL_PROFILE=
# Refuse a review when the key has less than this left
FINE_PRINT_MIN_BUDGET_USD=0.05
